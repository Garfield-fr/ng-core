{
  "name": "@rero/ng-core",
  "version": "21.3.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "ng": "ng",
    "serve": "ng serve --configuration localhost",
    "build-css": "postcss  --config projects/rero/ng-core projects/rero/ng-core/tailwind.css -o projects/rero/ng-core/assets/scss/ng-core-tailwind.scss",
    "build-lib": "ng build --configuration production @rero/ng-core",
    "pack": "pnpm run build-css && ng build --configuration production @rero/ng-core && cd dist/rero/ng-core && pnpm pack --pack-destination ../../..",
    "test-lib": "ng test @rero/ng-core",
    "lint": "ng lint --cache",
    "extract_messages": "ngx-translate-extract -k -c -s -i ./projects/rero/ng-core/src -o ./projects/rero/ng-core/translations/messages.json --fi '  '",
    "update_catalog": "ngx-translate-extract -k -c -s -i ./projects/rero/ng-core/src -o ./projects/rero/ng-core/src/lib/translate/i18n/{de,en,fr,it,ar,cs,eo,es,nl,ta,uk}.json --fi '  '",
    "format": "prettier --write projects/**/*.{ts,html,scss,json}",
    "release": "semantic-release"
  },
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ngrx/signals": "^22.0.0",
    "@ngx-formly/core": "^7.1.0",
    "@ngx-formly/primeng": "^7.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@openng/optimus-ui": "^2.0.1",
    "crypto-js": "^4.2.0",
    "easymde": "^2.21.0",
    "generate-password-lite": "^1.0.2",
    "katex": "^0.18.4",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "marked": "^18.0.10",
    "ngx-spinner": "^21.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "@openng/optimus-ui-themes": "^2.0.1",
    "@openng/optimus-ui-locale": "^2.0.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/language-service": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@ngx-formly/schematics": "^7.1.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/json-schema": "^7.0.15",
    "@types/katex": "^0.16.8",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.5",
    "@vendure/ngx-translate-extract": "^10.2.0",
    "@vitest/browser-playwright": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^17.0.0",
    "postcss-rename": "^0.8.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "@openng/optimus-ui-tailwindcss": "^2.0.1"
  }
}
